      "highlight": "#FFFFFF",
      "stroke": "#181715",
      "title": "#181715",
      "title_bg": "rgba(255,255,255,0.92)"
    },
    "captions": {
      "anchor_y": 0.53,
      "anchor_y_full": 0.74,
      "max_words": 3,
