# Планировщик (этап 3). Без ANTHROPIC_API_KEY используется вход Claude Code по подписке (бэкенд agent).
ANTHROPIC_API_KEY=
# VEDIT_PLANNER=auto          # auto | api | agent | mock
# VEDIT_PLANNER_MODEL=claude-opus-5-5
# VEDIT_FALLBACKS=1           # server-side refusal fallbacks (только api; спасённый ответ считается без цены)

# Понимание видео (этап 2b, когда появится Gemini-провайдер)
GEMINI_API_KEY=
# Транскрипция через OpenAI Whisper API (альтернатива локальному whisper.cpp)
OPENAI_API_KEY=

# Optional: override ffmpeg/ffprobe/whisper binaries
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe
# WHISPER_BIN=vendor/whisper/bin/Release/whisper-cli.exe
# WHISPER_MODEL=vendor/whisper/ggml-large-v3-turbo-q5_0.bin
