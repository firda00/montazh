# Планировщик (этап 3). Без ANTHROPIC_API_KEY используется вход Claude Code по подписке (бэкенд agent).
ANTHROPIC_API_KEY=
# VEDIT_PLANNER=auto          # auto | api | agent | mock
# VEDIT_PLANNER_MODEL=claude-opus-5-5
# VEDIT_FALLBACKS=1           # server-side refusal fallbacks (только api; спасённый ответ считается без цены)
# Лимиты планировщика (флаги --budget / --max-repairs / --frames сильнее; см. `vedit modules`)
# VEDIT_BUDGET_USD=1.5
# VEDIT_BUDGET_WALL_S=240
# VEDIT_BUDGET_CALLS=12
# VEDIT_BUDGET_REPAIRS=2
# VEDIT_BUDGET_TOOL_CALLS=16
# VEDIT_BUDGET_FRAMES=6

# Понимание кадра: Gemini (сцены, лица для auto_face, highlights). Без ключа — честная заглушка.
# Ключ: aistudio.google.com/apikey
GEMINI_API_KEY=
# VEDIT_VISION_MODEL=gemini-2.5-flash-lite     # или gemini-2.5-flash / gemini-2.5-pro
# VEDIT_VISION_RESOLUTION=low                  # low | medium | high — токенов на кадр (по умолчанию — как у API)
# Без ключа: Antigravity CLI (agy, вход Google). auto = ключ → agy, если установлен → stub.
# VEDIT_VISION=auto                            # auto | gemini | agy | stub

# Монтаж по примеру (этап 22): тот же GEMINI_API_KEY смотрит рилс-пример → Style DNA (кэш workspace/_cache/style).
# VEDIT_STYLE_MODEL=gemini-3.8-flash,gemini-3.6-flash   # список моделей по порядку
# VEDIT_STYLE_FPS=4                            # кадров/с, которые видит модель
# VEDIT_STYLE_RESOLUTION=high                  # low | medium | high (low путает цвета субтитров)
# Ссылки на примеры (Instagram / TikTok / YouTube Shorts) — yt-dlp (Unlicense), если он не в PATH. Без него — только файлы.
# VEDIT_YTDLP=C:/tools/yt-dlp.exe

# Самопроверка ИИ (этап 28): после доставки бот в фоне показывает каждый ролик Gemini (копия 480p, Files API, загрузка
# удаляется сразу) → оценки 1–5 и три правки, видит только админ (/admin → 📊 Оценки). ≈ $0.003 за ролик, кэш по хэшу файла.
# VEDIT_SELF_REVIEW=on                         # on | off
# VEDIT_REVIEW_MODEL=gemini-3.5-flash-lite,gemini-3.6-flash   # список моделей по порядку
# VEDIT_SELF_REVIEW_MAX=3                      # сколько роликов одной задачи смотреть
# VEDIT_REVIEW_FPS=1                           # кадров/с, которые видит критик
# VEDIT_REVIEW_RESOLUTION=                     # low | medium | high (по умолчанию — как у API)

# Голос (этап 17): Gemini TTS — тот же GEMINI_API_KEY (aistudio.google.com → Get API key) озвучивает голосами
# gemini_* (по умолчанию для make и avatar — gemini_charon). Либо Google Cloud Text-to-Speech:
# console.cloud.google.com → APIs & Services → включить «Cloud Text-to-Speech API» → Credentials → Create API key
# (ограничить этим API). Если есть оба ключа, берётся Cloud. Без ключей gemini_*/chirp_* звучат голосом Piper.
# GOOGLE_CLOUD_API_KEY=
# VEDIT_GEMINI_TTS_MODEL=gemini-3.8-flash-tts   # первая модель; дальше 3.1-flash-tts-preview → 2.5-flash-preview-tts → 3.8-flash-lite-tts
# VEDIT_GEMINI_TTS_API=interactions             # interactions (по умолчанию) | generateContent
# VEDIT_GEMINI_TTS_STYLE=a lively, confident documentary narrator
# VEDIT_GEMINI_TTS_CONCURRENCY=1                # 1–2 параллельных запроса (бесплатный уровень — 1)
# VEDIT_CLOUD_TTS_MODEL=gemini-2.5-flash-tts    # Cloud Gemini-TTS; дальше 2.5-pro-tts → 3.1-flash-tts-preview
# VEDIT_AGY_BIN=C:/Users/me/AppData/Local/agy/bin/agy.exe   # если agy не в PATH
# Транскрипция через OpenAI Whisper API (альтернатива локальному whisper.cpp)
OPENAI_API_KEY=

# Длинное видео (этап 8): сайдкар tools/asr (faster-whisper + говорящие)
# VEDIT_ASR=auto               # auto | cpp | faster; auto = faster только при NVIDIA GPU
# VEDIT_ASR_MODEL=large-v3-turbo
# VEDIT_ASR_PYTHON=tools/asr/.venv/Scripts/python.exe
# VEDIT_DIARIZE=1              # 0 — не размечать говорящих

# Optional: override ffmpeg/ffprobe/whisper binaries
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe
# WHISPER_BIN=vendor/whisper/bin/Release/whisper-cli.exe
# WHISPER_MODEL=vendor/whisper/ggml-large-v3-turbo-q5_0.bin

# Telegram-бот (этап 7, этап 19 — много пользователей): токен от @BotFather.
TELEGRAM_BOT_TOKEN=
# Закрытая бета: только эти user id через запятую (остальных бот молча игнорирует). Пусто — открытая регистрация
# (расходы ограничивают дневные лимиты и кредиты ниже).
TELEGRAM_ALLOWED_USERS=
# Админы: /admin (статистика, пользователи, кредиты, рассылка, лимиты) и технические ошибки задач.
# Пусто — первый id из TELEGRAM_ALLOWED_USERS.
TELEGRAM_ADMIN_IDS=
# TELEGRAM_API_BASE=http://localhost:8081   # локальный telegram-bot-api (--local): файлы до 2000 МБ вместо 20/50 МБ
# Очередь и хранение
# VEDIT_MAX_JOBS=1               # задач одновременно (по умолчанию 1 при < 12 ГБ RAM, иначе 2)
# VEDIT_RETENTION_DAYS=7         # загрузки и готовые задачи старше — удаляются (раз в сутки)
# VEDIT_TZ_OFFSET=5              # граница суток для дневных лимитов, часы от UTC (Ташкент)
# Бесплатный тариф (админ меняет на лету: /admin → ⚙️ Лимиты — значения из базы сильнее этих)
# VEDIT_FREE_JOBS_PER_DAY=3      # обычных задач в день (монтаж, ролик по теме, правка, монтаж аватара)
# VEDIT_FREE_LONG_PER_DAY=1      # длинных задач в день (видео > VEDIT_LONG_MINUTES или хайлайты)
# VEDIT_LONG_MINUTES=15
# VEDIT_TRIAL_CREDITS=3          # кредитов после регистрации
# VEDIT_CREDITS_STANDARD=1       # цена обычной задачи сверх лимита, кредитов
# VEDIT_CREDITS_LONG=3           # цена длинной задачи сверх лимита, кредитов
# VEDIT_FREE_UPLOAD_MB=20        # максимум файла от пользователя (не больше лимита Bot API)
