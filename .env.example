# Планировщик (этап 3). Без ANTHROPIC_API_KEY используется вход Claude Code по подписке (бэкенд agent).
ANTHROPIC_API_KEY=
# VEDIT_PLANNER=auto          # auto | api | agent | mock
# VEDIT_PLANNER_MODEL=claude-opus-5-5
# VEDIT_FALLBACKS=1           # server-side refusal fallbacks (только api; спасённый ответ считается без цены)
# Лимиты планировщика (флаги --budget / --max-repairs / --frames сильнее; см. `vedit modules`)
# VEDIT_BUDGET_USD=1.5
# VEDIT_BUDGET_WALL_S=240
# VEDIT_BUDGET_CALLS=12
# VEDIT_BUDGET_REPAIRS=2
# VEDIT_BUDGET_TOOL_CALLS=16
# VEDIT_BUDGET_FRAMES=6

# Понимание кадра: Gemini (сцены, лица для auto_face, highlights). Без ключа — честная заглушка.
# Ключ: aistudio.google.com/apikey
GEMINI_API_KEY=
# VEDIT_VISION_MODEL=gemini-2.5-flash-lite     # или gemini-2.5-flash / gemini-2.5-pro
# VEDIT_VISION_RESOLUTION=low                  # low | medium | high — токенов на кадр (по умолчанию — как у API)
# Без ключа: Antigravity CLI (agy, вход Google). auto = ключ → agy, если установлен → stub.
# VEDIT_VISION=auto                            # auto | gemini | agy | stub
# VEDIT_AGY_BIN=C:/Users/me/AppData/Local/agy/bin/agy.exe   # если agy не в PATH
# Транскрипция через OpenAI Whisper API (альтернатива локальному whisper.cpp)
OPENAI_API_KEY=

# Длинное видео (этап 8): сайдкар tools/asr (faster-whisper + говорящие)
# VEDIT_ASR=auto               # auto | cpp | faster; auto = faster только при NVIDIA GPU
# VEDIT_ASR_MODEL=large-v3-turbo
# VEDIT_ASR_PYTHON=tools/asr/.venv/Scripts/python.exe
# VEDIT_DIARIZE=1              # 0 — не размечать говорящих

# Optional: override ffmpeg/ffprobe/whisper binaries
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe
# WHISPER_BIN=vendor/whisper/bin/Release/whisper-cli.exe
# WHISPER_MODEL=vendor/whisper/ggml-large-v3-turbo-q5_0.bin

# Telegram-бот (этап 7): токен от @BotFather и список разрешённых user id через запятую.
# Без TELEGRAM_ALLOWED_USERS бот отвечает всем (каждый монтаж тратит деньги на планировщик).
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=
# TELEGRAM_API_BASE=http://localhost:8081   # локальный telegram-bot-api (--local): файлы до 2000 МБ вместо 20/50 МБ
